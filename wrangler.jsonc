{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhue-site",
  "compatibility_date": "2026-11-01",

  "account_id": "2b62d2b133a61c5044a548ee33573ae6",

  // assets only, no worker script. vite build → dist
  "assets": {
    "directory": "./dist",
    // client-side routes (/design, /changelog/m25) fall back to index.html
    "not_found_handling": "single-page-application"
  },

  "routes": [
    { "pattern": "rhue.dev", "custom_domain": true }
  ],
  "workers_dev": false
}
